  <div class="toast" id="toast"></div>

  <script>
    const modal=document.getElementById('modal');
    const title=document.getElementById('sheetTitle');
    const content=document.getElementById('sheetContent');
    let selectedAmount=500;

    document.querySelectorAll('.nav-btn').forEach(btn=>{
      btn.addEventListener('click',()=>goPage(btn.dataset.page));
    });

    function goPage(id){
      document.querySelectorAll('.page').forEach(p=>p.classList.remove('active'));
      document.getElementById(id).classList.add('active');
      document.querySelectorAll('.nav-btn').forEach(b=>b.classList.toggle('active', b.dataset.page===id));
      window.scrollTo({top:0,behavior:'smooth'});
    }

    function openSheet(type){
      modal.classList.add('open');
      if(type==='recharge'){
        title.textContent='Recargar saldo';
        content.innerHTML=`
          <span class="label">Selecciona un monto</span>
          <div class="option-grid">
            <button class="option selected" onclick="pick(this,300)">RD$ 300</button>
            <button class="option" onclick="pick(this,500)">RD$ 500</button>
            <button class="option" onclick="pick(this,1000)">RD$ 1,000</button>
          </div>
          <span class="label">Otro monto</span>
          <input class="input" id="customAmount" type="number" placeholder="Escribe un monto">
          <span class="label">Método de origen</span>
          <select class="input">
            <option>Saldo familiar</option>
            <option>Tarjeta Visa •••• 4242</option>
            <option>Tarjeta Mastercard •••• 1188</option>
          </select>
          <button class="full-btn" onclick="doRecharge()">Confirmar recarga</button>
        `;
      }
      if(type==='send'){
        title.textContent='Enviar saldo';
        content.innerHTML=`
          <span class="label">Enviar a</span>
          <input class="input" id="toUser" placeholder="Nombre o ID del estudiante">
          <span class="label">Monto</span>
          <input class="input" id="sendAmount" type="number" placeholder="Ej. 100">
          <span class="label">Motivo</span>
          <select class="input">
            <option>Compartir saldo</option>
            <option>Devolver dinero</option>
            <option>Apoyo entre amigos</option>
          </select>
          <button class="full-btn" onclick="doSend()">Enviar saldo</button>
        `;
      }
      if(type==='budget'){
        title.textContent='Configurar gasto de cine';
        content.innerHTML=`
          <span class="label">Presupuesto mensual para cine</span>
          <input class="input" value="600" type="number">
          <span class="label">Incluye</span>
          <select class="input">
            <option>Boletos + combo</option>
            <option>Solo boletos</option>
            <option>Boletos + combo + transporte</option>
          </select>
          <span class="label">Meta por salida</span>
          <input class="input" value="300" type="number">
          <button class="full-btn" onclick="saveBudget()">Guardar presupuesto</button>
        `;
      }
    }

    function closeSheet(){
      modal.classList.remove('open');
    }

    function pick(el,val){
      selectedAmount=val;
      document.querySelectorAll('.option').forEach(o=>o.classList.remove('selected'));
      el.classList.add('selected');
      const c=document.getElementById('customAmount');
      if(c) c.value='';
    }

    function doRecharge(){
      const custom=document.getElementById('customAmount');
      const amount=(custom && Number(custom.value)>0) ? Number(custom.value) : selectedAmount;
      const balance=document.getElementById('balance');
      const current=parseInt(balance.textContent.replace(/[^\d]/g,''),10) || 0;
      balance.textContent='RD$ ' + (current + amount).toLocaleString('es-DO');
      closeSheet();
      notify('Recarga aplicada por RD$ ' + amount.toLocaleString('es-DO'));
    }

    function doSend(){
      const to=document.getElementById('toUser').value || 'otro estudiante';
      const amount=Number(document.getElementById('sendAmount').value || 0);
      if(!amount){
        notify('Escribe un monto válido');
        return;
      }
      closeSheet();
      notify('Se enviaron RD$ ' + amount.toLocaleString('es-DO') + ' a ' + to);
    }

    function saveBudget(){
      closeSheet();
      notify('Presupuesto de cine actualizado');
    }

    function notify(msg){
      const t=document.getElementById('toast');
      t.textContent=msg;
      t.classList.add('show');
      setTimeout(()=>t.classList.remove('show'),2600);
    }
  </script>
</body>
</html>
