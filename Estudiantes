<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Pikas | App del Estudiante</title>
  <style>
    :root{
      --primary:#5b3df5;
      --primary2:#7a5cff;
      --bg:#f4f6fb;
      --card:#ffffff;
      --ink:#1a2340;
      --muted:#73809a;
      --line:#e8ecf5;
      --success:#12a871;
      --danger:#e14d5a;
      --warning:#f5a524;
      --shadow:0 18px 44px rgba(37,49,88,.10);
      --radius:24px;
    }
    *{box-sizing:border-box}
    body{
      margin:0;
      font-family:Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      background:linear-gradient(180deg,#eef2ff 0%, #f7f9fd 26%, #f4f6fb 100%);
      color:var(--ink);
    }
    button,input,select{font:inherit}
    button{cursor:pointer}
    .phone-shell{
      width:min(430px,100%);
      min-height:100vh;
      margin:0 auto;
      background:var(--bg);
      position:relative;
      box-shadow:0 0 0 1px rgba(255,255,255,.5);
    }
    .top{
      padding:20px 18px 8px;
    }
    .status{
      display:flex;justify-content:space-between;align-items:center;
      font-size:12px;color:var(--muted);margin-bottom:12px
    }
    .brand-row{
      display:flex;align-items:center;justify-content:space-between;margin-bottom:16px
    }
    .brand{
      display:flex;align-items:center;gap:12px
    }
    .brand-badge{
      width:44px;height:44px;border-radius:16px;
      background:linear-gradient(135deg,var(--primary),var(--primary2));
      color:#fff;display:grid;place-items:center;font-weight:900;font-size:18px;
      box-shadow:0 10px 24px rgba(91,61,245,.25)
    }
    .brand strong{display:block;font-size:18px}
    .brand small{color:var(--muted)}
    .ghost-btn{
      border:0;background:#fff;width:42px;height:42px;border-radius:14px;box-shadow:var(--shadow)
    }
    .card{
      background:var(--card);
      border-radius:var(--radius);
      box-shadow:var(--shadow);
    }
    .hero-wallet{
      margin:0 18px;
      padding:20px;
      color:#fff;
      background:linear-gradient(135deg,#3820c8 0%, #5b3df5 48%, #7a5cff 100%);
      position:relative;overflow:hidden
    }
    .hero-wallet:before,.hero-wallet:after{
      content:"";position:absolute;border-radius:50%;background:rgba(255,255,255,.09)
    }
    .hero-wallet:before{width:180px;height:180px;right:-65px;top:-60px}
    .hero-wallet:after{width:120px;height:120px;left:-30px;bottom:-55px}
    .hero-wallet small{opacity:.8}
    .hero-top{display:flex;justify-content:space-between;align-items:flex-start;gap:12px;position:relative;z-index:1}
    .hero-top .mini-chip{
      border:1px solid rgba(255,255,255,.25);background:rgba(255,255,255,.08);
      padding:8px 10px;border-radius:999px;font-size:12px;font-weight:700
    }
    .balance{
      font-size:40px;font-weight:900;letter-spacing:-1px;margin:6px 0 16px;position:relative;z-index:1
    }
    .hero-meta{
      display:grid;grid-template-columns:1fr 1fr;gap:10px;position:relative;z-index:1
    }
    .meta{
      background:rgba(255,255,255,.09);border:1px solid rgba(255,255,255,.12);
      border-radius:16px;padding:11px 12px
    }
    .meta span{display:block;font-size:11px;opacity:.8;margin-bottom:4px}
    .meta strong{font-size:14px}
    .section{
      padding:18px;
    }
    .section-head{
      display:flex;justify-content:space-between;align-items:center;margin-bottom:14px
    }
    .section-head h2{
      margin:0;font-size:18px
    }
    .section-head a{
      text-decoration:none;color:var(--primary);font-size:13px;font-weight:800
    }
    .student-id{
      padding:16px;
      display:grid;
      grid-template-columns:1fr 92px;
      gap:14px;
      align-items:center;
    }
    .student-id .name{font-size:20px;font-weight:900;margin-bottom:3px}
    .student-id .school{font-size:12px;color:var(--muted);margin-bottom:12px}
    .id-tags{display:flex;flex-wrap:wrap;gap:8px}
    .pill{
      padding:7px 10px;border-radius:999px;background:#f1efff;color:var(--primary);
      font-size:11px;font-weight:800
    }
    .qr{
      width:92px;height:92px;border-radius:18px;background:
      linear-gradient(90deg,#000 10%,transparent 10%) 0 0/12px 12px,
      linear-gradient(#000 10%,transparent 10%) 0 0/12px 12px,
      #fff;
      border:8px solid #fff;
      box-shadow:inset 0 0 0 1px var(--line), 0 10px 24px rgba(0,0,0,.08)
    }
    .quick-grid{
      display:grid;grid-template-columns:repeat(4,1fr);gap:10px
    }
    .quick{
      border:0;background:#fff;border-radius:18px;padding:14px 6px;
      box-shadow:var(--shadow);text-align:center
    }
    .quick .ico{font-size:22px;margin-bottom:8px}
    .quick span{display:block;font-size:11px;font-weight:800;line-height:1.2}
    .menu-list,.list{
      display:flex;flex-direction:column;gap:12px
    }
    .item{
      background:#fff;border-radius:20px;padding:14px;box-shadow:var(--shadow)
    }
    .row{
      display:flex;align-items:center;gap:12px
    }
    .thumb{
      width:54px;height:54px;border-radius:16px;display:grid;place-items:center;
      font-size:26px;flex:0 0 auto
    }
    .thumb.food1{background:linear-gradient(135deg,#ffefc3,#ffc46b)}
    .thumb.food2{background:linear-gradient(135deg,#d5f8d7,#66d69c)}
    .thumb.food3{background:linear-gradient(135deg,#ffd7d7,#ff9d9d)}
    .thumb.cine{background:linear-gradient(135deg,#ddd7ff,#a290ff)}
    .thumb.wallet{background:linear-gradient(135deg,#d4e7ff,#8ebcff)}
    .item strong{display:block;font-size:15px}
    .item small{color:var(--muted)}
    .price{
      margin-left:auto;font-weight:900
    }
    .action-btn,.action-btn-light{
      border:0;border-radius:14px;padding:10px 12px;font-weight:800
    }
    .action-btn{background:var(--primary);color:#fff}
    .action-btn-light{background:#f1efff;color:var(--primary)}
    .item-bottom{
      margin-top:12px;display:flex;justify-content:space-between;align-items:center;gap:12px
    }
    .cards{
      display:flex;gap:12px;overflow:auto;padding-bottom:2px
    }
    .bank-card{
      min-width:220px;border-radius:22px;padding:16px;color:#fff;
      background:linear-gradient(135deg,#20305e,#4561a5 55%, #5d80d8);
      box-shadow:var(--shadow)
    }
    .bank-card.alt{
      background:linear-gradient(135deg,#0f7258,#14a37d 55%, #37c396);
    }
    .bank-card small{opacity:.8}
    .bank-card .number{margin:18px 0 12px;font-size:18px;font-weight:900;letter-spacing:1px}
    .subcard{
      background:#fff;border-radius:20px;padding:14px;box-shadow:var(--shadow)
    }
    .subcard h3{margin:0 0 6px;font-size:16px}
    .subcard p{margin:0;color:var(--muted);font-size:13px;line-height:1.45}
    .budget-grid{
      display:grid;grid-template-columns:1fr 1fr;gap:12px
    }
    .budget{
      background:#fff;border-radius:20px;padding:14px;box-shadow:var(--shadow)
    }
    .budget .kpi{font-size:24px;font-weight:900;margin:6px 0}
    .budget .bar{height:10px;background:#eceff6;border-radius:99px;overflow:hidden;margin-top:10px}
    .budget .bar div{height:100%;border-radius:inherit}
    .tx{
      display:flex;align-items:center;gap:12px;background:#fff;border-radius:18px;padding:12px;box-shadow:var(--shadow)
    }
    .tx .amt{margin-left:auto;font-weight:900}
    .tx .amt.negative{color:var(--danger)}
    .tx .amt.positive{color:var(--success)}
    .bottom-space{height:110px}
    .nav{
      position:fixed;left:50%;transform:translateX(-50%);
      bottom:0;width:min(430px,100%);
      background:rgba(255,255,255,.94);backdrop-filter:blur(10px);
      border-top:1px solid var(--line);padding:10px 12px 14px;z-index:40
    }
    .nav-grid{
      display:grid;grid-template-columns:repeat(5,1fr);gap:6px
    }
    .nav-btn{
      border:0;background:transparent;padding:8px 4px;border-radius:16px;color:var(--muted)
    }
    .nav-btn.active{background:#f1efff;color:var(--primary)}
    .nav-btn .nicon{display:block;font-size:20px;margin-bottom:4px}
    .nav-btn span:last-child{font-size:11px;font-weight:800}
    .page{display:none}
    .page.active{display:block}
    .modal{
      position:fixed;inset:0;background:rgba(16,24,44,.48);display:none;
      align-items:flex-end;justify-content:center;z-index:60
    }
    .modal.open{display:flex}
    .sheet{
      width:min(430px,100%);background:#fff;border-radius:26px 26px 0 0;padding:16px 18px 26px;
      max-height:88vh;overflow:auto;box-shadow:0 -20px 50px rgba(0,0,0,.18)
    }
    .grabber{
      width:44px;height:5px;border-radius:99px;background:#d7deeb;margin:0 auto 14px
    }
    .sheet-head{
      display:flex;justify-content:space-between;align-items:center;margin-bottom:16px
    }
    .sheet-head h3{margin:0}
    .close{
      border:0;background:#f2f4f8;border-radius:12px;width:38px;height:38px
    }
    .option-grid{
      display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin:16px 0
    }
    .option{
      border:1px solid var(--line);background:#fff;border-radius:16px;padding:14px 8px;font-weight:900
    }
    .option.selected{border-color:var(--primary);background:#f3f0ff;color:var(--primary)}
    .label{display:block;font-size:12px;color:var(--muted);margin-bottom:6px}
    .input{
      width:100%;border:1px solid var(--line);border-radius:14px;padding:13px 12px;margin-bottom:14px
    }
    .full-btn{
      width:100%;border:0;background:var(--primary);color:#fff;padding:14px;border-radius:16px;font-weight:900
    }
    .toast{
      position:fixed;left:50%;transform:translateX(-50%) translateY(120px);
      bottom:100px;background:#1f2845;color:#fff;padding:12px 16px;border-radius:14px;
      box-shadow:0 14px 38px rgba(0,0,0,.22);opacity:0;transition:.28s;z-index:80;
      width:calc(min(430px,100%) - 36px);text-align:center
    }
    .toast.show{transform:translateX(-50%) translateY(0);opacity:1}
  </style>
</head>
<body>
