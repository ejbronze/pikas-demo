# Required when demo mode is disabled. Never expose the service-role key to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
PIKAS_DEMO_PASSWORD=
# Explicit fictional-data evaluation mode. Production should normally use false;
# the currently published PIKAS demo may enable true by explicit authorization.
NEXT_PUBLIC_PIKAS_DEMO_MODE=true
